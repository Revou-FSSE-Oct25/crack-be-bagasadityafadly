// This file defines your database tables
// Every table = one "model" block

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User table — we'll expand this in authentication phase
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}