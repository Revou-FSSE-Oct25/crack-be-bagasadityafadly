// =============================================================================
// schema.prisma — GymFlow Booking System
// Prisma v5 — PostgreSQL
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMINISTRATOR
  ADMIN
  MEMBER
  NON_MEMBER
}

enum MembershipType {
  BASIC
  PREMIUM
  TRIAL
  NONE
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum BookingType {
  GYM
  CLASS
  PT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum XPSource {
  BOOKING
  ATTENDANCE
  STREAK
  CHALLENGE
  BONUS
  ASSESSMENT
}

enum ChallengeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum GoalType {
  MUSCLE_GAIN
  FAT_LOSS
  MAINTAIN
  ENDURANCE
  FLEXIBILITY
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PreferredTime {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           Role     @default(NON_MEMBER)
  xpTotal        Int      @default(0) @map("xp_total")
  level          Int      @default(1)
  streakCount    Int      @default(0) @map("streak_count")
  lastCheckIn    DateTime? @map("last_check_in")
  avatarUrl      String?  @map("avatar_url")
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Streak milestone flags — set automatically when streak hits 3 / 30 days
  bronzeBorderUnlocked Boolean  @default(false) @map("bronze_border_unlocked")
  canApplyAsPT         Boolean  @default(false) @map("can_apply_as_pt")

  // Password reset (null = no pending reset request)
  resetToken       String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  // Google Calendar OAuth tokens (null = user has not connected Google Calendar)
  googleAccessToken  String?   @map("google_access_token")
  googleRefreshToken String?   @map("google_refresh_token")
  googleTokenExpiry  DateTime? @map("google_token_expiry")

  memberships       Membership[]
  bookings          Booking[]
  xpHistories       XpHistory[]
  userBadges        UserBadge[]
  userRewards       UserReward[]
  challengeProgress ChallengeProgress[]
  bodyAssessments   BodyAssessment[]
  workoutPrograms   WorkoutProgram[]
  attendanceLogs    AttendanceLog[]

  @@map("users")
}

model Membership {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       MembershipType
  status     MembershipStatus @default(ACTIVE)
  startDate  DateTime         @map("start_date")
  endDate    DateTime         @map("end_date")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

model Trainer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  specialty    String?
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  schedules  Schedule[]
  ptBookings Booking[]

  @@map("trainers")
}

model Class {
  id                String       @id @default(cuid())
  name              String
  description       String?
  durationMinutes   Int          @map("duration_minutes")
  capacity          Int
  difficulty        WorkoutLevel @default(BEGINNER)
  caloriesEstimate  Int?         @map("calories_estimate")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  schedules Schedule[]

  @@map("classes")
}

model Schedule {
  id          String   @id @default(cuid())
  classId     String   @map("class_id")
  trainerId   String   @map("trainer_id")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  roomOrZone  String?  @map("room_or_zone")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class    Class    @relation(fields: [classId], references: [id])
  trainer  Trainer  @relation(fields: [trainerId], references: [id])
  bookings Booking[]

  @@map("schedules")
}

model Booking {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  scheduleId  String?       @map("schedule_id")
  trainerId   String?       @map("trainer_id")
  type        BookingType
  status      BookingStatus @default(PENDING)
  bookingDate DateTime      @map("booking_date")
  notes       String?
  qrCode        String?       @unique @map("qr_code")
  // Set after a Google Calendar event is created for this booking.
  // Null if the user has not connected Google Calendar or if sync failed.
  googleEventId String?       @map("google_event_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule       Schedule?      @relation(fields: [scheduleId], references: [id])
  trainer        Trainer?       @relation(fields: [trainerId], references: [id])
  attendanceLogs AttendanceLog[]

  // Prevents a user from booking the exact same schedule twice.
  // NOTE: PostgreSQL treats NULL != NULL in unique constraints, so
  // GYM bookings (scheduleId = null) are intentionally NOT covered here —
  // a user can book the gym on multiple different days.
  @@unique([userId, scheduleId])
  @@map("bookings")
}

model AttendanceLog {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  bookingId  String           @map("booking_id")
  method     AttendanceMethod @default(QR)
  checkedAt  DateTime         @default(now()) @map("checked_at")
  xpEarned   Int              @default(0) @map("xp_earned")
  createdAt  DateTime         @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("attendance_logs")
}

model XpHistory {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  source      XPSource
  amount      Int
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_histories")
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?  @map("icon_url")
  xpReward    Int      @default(0) @map("xp_reward")
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  xpCost      Int      @map("xp_cost")
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userRewards UserReward[]

  @@map("rewards")
}

model UserReward {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  rewardId   String   @map("reward_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at")
  // Coupon code generated for streak milestone rewards (e.g. 7-day Free Protein Drink)
  couponCode String?  @map("coupon_code")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("user_rewards")
}

model Challenge {
  id          String   @id @default(cuid())
  name        String
  description String?
  xpReward    Int      @map("xp_reward")
  target      Int
  durationDays Int     @map("duration_days")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  progress ChallengeProgress[]

  @@map("challenges")
}

model ChallengeProgress {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  challengeId String          @map("challenge_id")
  status      ChallengeStatus @default(NOT_STARTED)
  progress    Int             @default(0)
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@map("challenge_progress")
}

model BodyAssessment {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  weightKg        Float?       @map("weight_kg")
  heightCm        Float?       @map("height_cm")
  bodyFatPct      Float?       @map("body_fat_pct")
  goal            GoalType?
  workoutLevel    WorkoutLevel? @map("workout_level")
  preferredTime   PreferredTime? @map("preferred_time")
  assessedAt      DateTime     @default(now()) @map("assessed_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("body_assessments")
}

model WorkoutProgram {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String?
  programJson Json     @map("program_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_programs")
}