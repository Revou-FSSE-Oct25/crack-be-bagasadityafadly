# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://your_db_user@localhost:5432/gymflow_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────
# Ganti dengan string random yang panjang di production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002

# ─── Google Calendar ──────────────────────────────────────
# Get these from https://console.cloud.google.com
# APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/calendar/callback
