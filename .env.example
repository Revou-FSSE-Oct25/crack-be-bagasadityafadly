# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://your_db_user@localhost:5432/gymflow_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────
# Ganti dengan string random yang panjang di production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
